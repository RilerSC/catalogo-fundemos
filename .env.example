# Neon PostgreSQL. Copy this file to .env.local and set a real value locally.
# Do not commit credentials. Provision Neon during a later implementation step.
DATABASE_URL=

# Canonical public origin for metadata, sitemap and structured data.
# Required when VERCEL_ENV=production. Do not invent a host.
# Example: https://www.example.com
# SITE_URL=

# Optional GTM container. Not a secret. Leave empty until an institutional ID exists.
# Do not invent GTM-XXXXXXX. GA4 is configured inside GTM, not here.
# NEXT_PUBLIC_GTM_ID=

# Local contract debug. In development, events already log without this flag.
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# CMS authentication — documented for later implementation, not used in BOOTSTRAP-001.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# AUTH_SECRET=
